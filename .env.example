# "Connect Spotify" works with no setup — crate-builder ships with its own
# shared Spotify app (PKCE, no secret required). Only set SPOTIFY_CLIENT_ID
# below if you'd rather run your own app instead: create a free one at
# https://developer.spotify.com/dashboard (no client secret needed either
# way — PKCE doesn't use one).
SPOTIFY_CLIENT_ID=

# Must exactly match a Redirect URI you added in the Spotify app's Settings.
# Only change this if you're running the app on a different port than 5001.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5001/callback

# Showfile + Crate Builder Community — optional, and normally set from the
# app's own Settings page instead of here (Settings takes priority over
# these if both are set). These .env vars are just a fallback for local
# dev/scripting. See https://github.com/jpgion18/showfile and
# https://github.com/jpgion18/crate-builder-community.
SHOWFILE_API_URL=
SHOWFILE_API_KEY=
COMMUNITY_API_URL=https://crate.showfile.events
