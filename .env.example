# Create a free app at https://developer.spotify.com/dashboard to get these.
# Only needed if you want to paste Spotify playlist URLs instead of plain text/CSV.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match a Redirect URI you added in the Spotify app's Settings.
# Only change this if you're running the app on a different port than 5001.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5001/callback

# Showfile (showfile.events) — optional. If you use Showfile to manage DJ
# gigs, set these to push a matched playlist to an event's timeline
# suggestions via the "Sync to Showfile" button. Find your API key on the
# Showfile dashboard's "Playlist sync (crate-builder)" panel.
SHOWFILE_API_URL=
SHOWFILE_API_KEY=

# Crate Builder Community (https://github.com/jpgion18/crate-builder-community)
# — optional. Set this to browse the Community tab and publish crates you
# build (artist/title only, anonymous, opt-in per crate). Point it at your
# own deployment of that app.
COMMUNITY_API_URL=
